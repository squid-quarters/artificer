{
  "name": "artificer",
  "version": "1.0.0",
  "description": "A card layout tool to help you create card games.",
  "keywords": [
    "card",
    "game",
    "layout"
  ],
  "type": "module",
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.3.0"
  },
  "workspaces": [
    "app"
  ],
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  },
  "private": true
}
