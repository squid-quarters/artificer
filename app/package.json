{
  "name": "artificer-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@tauri-apps/api": "^2.12.3",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-svelte-csf": "^5.1.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/svelte-vite": "^10.6.1",
    "@storybook/sveltekit": "^10.6.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "storybook": "^10.6.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  }
}
